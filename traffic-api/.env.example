# Local development: copy this file to .env and fill in values locally.
# Never commit .env, passwords, access tokens, or real secrets.
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_MAP_JS_KEY=your_kakao_map_js_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini  # use a model supporting JSON output

# Supabase PostgreSQL transaction pooler (copy actual connection settings)
POSTGRES_HOST=your_pooler_host
POSTGRES_PORT=6543
POSTGRES_USER=your_pooler_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

# Supabase Auth (public anon/publishable key only, NEVER service-role or secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
ADMIN_USER_ID=your_admin_auth_user_uuid

# Generate a unique secret using: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Server-only, 32 bytes or more; do not reuse an API key.
NEWS_DRAFT_SIGNING_KEY=your_random_server_only_signing_key
CARTO_BASEMAP_KEY=your_carto_basemap_key